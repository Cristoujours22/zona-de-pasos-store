# Copy these names into .env.local and replace every placeholder.
# Public Supabase values (safe for browser clients)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only values. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SETUP_SECRET=replace-with-64-hex-characters-from-openssl-rand-hex-32
ORDER_TRACKING_SECRET=replace-with-a-different-64-hex-secret-from-openssl-rand-hex-32

# Server-only Cloudinary values. Never prefix these with NEXT_PUBLIC_.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
